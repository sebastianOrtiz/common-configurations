  {
   "description": "Unique internal identifier (e.g. 'Promo Vacunación 2026')",
   "fieldname": "title",
   "fieldtype": "Data",
   "in_list_view": 1,
   "label": "Title",
   "reqd": 1,
   "unique": 1
  },
  {
