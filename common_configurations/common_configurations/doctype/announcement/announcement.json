   "label": "Heading"
  },
  {
   "depends_on": "eval:doc.content_type=='text'",
   "description": "Text body of the announcement",
   "fieldname": "body",
   "fieldtype": "Small Text",
   "label": "Body",
   "mandatory_depends_on": "eval:doc.content_type=='text'"
  },
  {
   "depends_on": "eval:doc.content_type=='html'",
